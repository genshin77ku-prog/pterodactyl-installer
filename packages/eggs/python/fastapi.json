{
  "name": "python-fastapi",
  "category": "PYTHON",
  "author": "NovaNode",
  "description": "Python FastAPI Application",
  "dockerImage": "python:3.12-slim",
  "startupCommand": "python -m uvicorn main:app --host 0.0.0.0 --port 8000",
  "environmentVariables": {
    "PYTHONUNBUFFERED": "1"
  },
  "installScript": "#!/bin/bash\npip install fastapi uvicorn",
  "configurationFiles": {
    "main.py": {
      "content": "from fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get('/')\nasync def root():\n    return {'message': 'Hello from NovaNode'}"
    },
    "requirements.txt": {
      "content": "fastapi==0.104.1\nuvicorn==0.24.0"
    }
  }
}
